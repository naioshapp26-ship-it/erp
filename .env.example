# ========================================
# NAYOSH ERP — Environment Variables
# Copy to .env and adjust values
# ========================================

# REQUIRED — PostgreSQL connection string
# Local example:
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE_NAME
#
# Railway example (ERP service → Variables):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_PUBLIC_URL=${{Postgres.DATABASE_PUBLIC_URL}}
# DATABASE_SSL=true
#
# NEVER use placeholder hosts like "base", "db", or "localhost" in production.
#
# Obtain Railway DATABASE_URL from:
# Railway Dashboard → PostgreSQL service → Connect → Public Network → Connection URL
DATABASE_URL=

# false for local PostgreSQL | true for Railway/cloud PostgreSQL
# If omitted, SSL is auto-enabled for *.proxy.rlwy.net hosts
DATABASE_SSL=false

NODE_ENV=production

# Railway sets PORT automatically — do not hardcode in production
HOST=0.0.0.0

# Main domain for tenant subdomains (e.g. tenant.example.com)
BASE_DOMAIN=your-main-domain.com

# Public app URL — required on Railway so tenant login links use /t/{subdomain}
# Railway often sets RAILWAY_PUBLIC_DOMAIN automatically; PUBLIC_APP_URL overrides it.
PUBLIC_APP_URL=https://your-app.up.railway.app

TRUST_PROXY=1
UPLOADS_ROOT_DIR=uploads

# REQUIRED for multi-tenant DB encryption (64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_DB_ENCRYPTION_KEY=

# Optional — tenant provisioning (only if using separate tenant databases)
# PROVISION_DB_URL=
# TENANT_DB_URL_TEMPLATE=postgresql://USER:PASSWORD@HOST:5432/{db}

# ========================================
# PAYMENT GATEWAYS (Stripe + PayPal + Paymob)
# ========================================
# Keys are stored encrypted in DB via Super Admin UI:
#   /platform-payment-settings.html  (platform / SaaS)
#   /tenant-payment-settings.html    (per tenant — gateway config)
#   /credit-topup.html               (credit balance top-up)
#   /public-payments.html            (public payment hub for new customers)
#
# REQUIRED for encrypting payment secrets in database:
# TENANT_DB_ENCRYPTION_KEY=  (64 hex chars — generate below)
#
# Store currency for cart / Paymob tenant checkout
STORE_CURRENCY=SAR

# SaaS signup payment behavior (same as Naiosh Fit)
# SAAS_REQUIRE_PAYMENT=1       → force payment before provisioning
# SAAS_SKIP_PAYMENT=1          → skip payment step (default in dev)
# SAAS_ALLOW_DIRECT_SIGNUP=1   → allow signup without gateway
# PAYMENT_AUTO_ENABLE=1        → auto-enable gateways when env keys are set (default)
# PAYMENT_DEMO_MODE=1          → allow demo credit top-up without real gateway keys

# Platform payment keys (auto-seeded on boot when PAYMENT_AUTO_ENABLE=1)
# PLATFORM_STRIPE_PUBLIC_KEY=pk_test_...
# PLATFORM_STRIPE_SECRET_KEY=sk_test_...
# PLATFORM_STRIPE_WEBHOOK_SECRET=whsec_...
# PLATFORM_STRIPE_ENABLED=1
# PLATFORM_PAYPAL_CLIENT_ID=
# PLATFORM_PAYPAL_CLIENT_SECRET=
# PLATFORM_PAYPAL_WEBHOOK_ID=
# PLATFORM_PAYPAL_ENABLED=1
# PLATFORM_PAYMOB_PUBLIC_KEY=
# PLATFORM_PAYMOB_SECRET_KEY=
# PLATFORM_PAYMOB_HMAC_SECRET=
# PLATFORM_PAYMOB_INTEGRATION_IDS=["123456"]
# PLATFORM_PAYMOB_BASE_URL=https://accept.paymob.com
# PLATFORM_PAYMOB_ENABLED=1

# Optional — override credit top-up bundles (JSON array)
# CREDIT_BUNDLES_JSON=[{"id":"starter","name":"باقة البداية","credits":100,"amount":49,"currency":"SAR"}]

# Railway webhook URLs to register with providers (replace YOUR_DOMAIN):
# Stripe:  https://YOUR_DOMAIN/api/payment/webhook/stripe/platform
#          https://TENANT.YOUR_DOMAIN/api/payment/webhook/stripe/tenant
# PayPal:  https://YOUR_DOMAIN/api/payment/webhook/paypal/platform
# Paymob:  https://YOUR_DOMAIN/api/payment/webhook/paymob/platform

# Optional diagnostics
DEBUG_AUTH=0
PG_POOL_MAX=4
TENANT_POOL_TTL_MS=1800000
